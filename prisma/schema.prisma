generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  height      Float?   // cm
  weight      Float?   // kg
  goalWeight  Float?   // kg
  birthDate   DateTime?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs             Run[]
  bodyMeasurements BodyMeasurement[]
  achievements     Achievement[]
  goals            Goal[]
  nutritionLogs    NutritionLog[]
  shoes            Shoe[]
  weatherRecords   WeatherRecord[]
}

model Run {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime
  distance      Float    // km
  duration      Float    // minutes
  pace          Float    // min/km
  avgHeartRate  Int?
  maxHeartRate  Int?
  cadence       Int?     // steps per minute
  power         Float?   // watts
  elevation     Float?   // meters
  calories      Int?
  indoor        Boolean  @default(false)
  effort        Int?     // 1-10 scale
  notes         String?
  route         String?  // route name or description
  routeData     Json?    // GeoJSON for map
  moodBefore    Int?     // 1-5
  moodAfter     Int?     // 1-5
  photos        String[] // array of URLs
  aiAnalysis    String?  // AI-generated summary
  coachScore    Float?   // AI coach score
  recoveryScore Float?
  trainingLoad  String?  // easy, moderate, hard, intense
  shoeId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id])
  shoe    Shoe?          @relation(fields: [shoeId], references: [id])
  weather WeatherRecord?
}

model BodyMeasurement {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  weight    Float?   // kg
  waist     Float?   // cm
  hips      Float?   // cm
  chest     Float?   // cm
  arms      Float?   // cm
  thighs    Float?   // cm
  bodyFat   Float?   // percentage
  bmi       Float?
  restingHR Int?     // bpm
  sleep     Float?   // hours
  water     Float?   // liters
  photos    String[] // progress photos
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Achievement {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String
  category     String   // distance, streak, weather, heartRate, special
  icon         String   // emoji or icon name
  tier         String   // bronze, silver, gold, platinum, diamond, crown
  dateUnlocked DateTime
  progress     Float?   // 0-100
  target       Float?
  current      Float?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String   // weight, distance, pace, streak, custom
  target      Float
  current     Float    @default(0)
  unit        String   // kg, km, min/km, days
  deadline    DateTime?
  status      String   @default("active") // active, completed, failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model NutritionLog {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  calories    Int?
  protein     Float?   // grams
  carbs       Float?   // grams
  fat         Float?   // grams
  fiber       Float?   // grams
  water       Float?   // liters
  supplements String[] // array of supplement names
  notes       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Shoe {
  id               String   @id @default(cuid())
  userId           String
  brand            String
  model            String
  purchaseDate     DateTime
  currentDistance   Float    @default(0) // km
  expectedLifetime Float    @default(800) // km
  retireAt         Float    @default(800) // km
  retired          Boolean  @default(false)
  notes            String?
  imageUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  runs Run[]
}

model WeatherRecord {
  id          String   @id @default(cuid())
  userId      String
  runId       String   @unique
  temperature Float?   // celsius
  humidity    Float?   // percentage
  windSpeed   Float?   // km/h
  windDir     String?
  pressure    Float?   // hPa
  aqi         Int?     // air quality index
  condition   String?  // clear, cloudy, rain, etc.
  feelsLike   Float?   // celsius
  sunrise     String?
  sunset      String?
  uvIndex     Float?
  visibility  Float?   // km
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  run  Run  @relation(fields: [runId], references: [id])
}
